load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "swbus_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swbus_config",
    edition = "2021",
    deps = [
        "//crates/swbus-proto:swbus_proto",
        "//crates/swss-serde:swss_serde",
        "@dash_ha_crates//:swss-common",
        "@dash_ha_crates//:serde",
        "@dash_ha_crates//:serde_yaml",
        "@dash_ha_crates//:serde_json",
        "@dash_ha_crates//:thiserror",
        "@dash_ha_crates//:tracing",
    ],
)
