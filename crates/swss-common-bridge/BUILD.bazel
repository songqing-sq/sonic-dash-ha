load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

# Cargo.toml requests `swss-common = { features = ["async"] }`; the async
# surface is globally enabled on @dash_ha_crates//:swss-common.
rust_library(
    name = "swss_common_bridge",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "swss_common_bridge",
    edition = "2021",
    proc_macro_deps = [
        "//crates/sonicdb-derive:sonicdb_derive",
    ],
    deps = [
        "//crates/swbus-actor:swbus_actor",
        "//crates/swbus-edge:swbus_edge",
        "//crates/sonic-common:sonic_common",
        "//crates/sonic-dash-api-proto:sonic_dash_api_proto",
        "@dash_ha_crates//:swss-common",
        "@dash_ha_crates//:tokio",
        "@dash_ha_crates//:tokio-util",
        "@dash_ha_crates//:anyhow",
        "@dash_ha_crates//:prost",
        "@dash_ha_crates//:hex",
        "@dash_ha_crates//:serde",
        "@dash_ha_crates//:serde_json",
        "@dash_ha_crates//:tracing",
    ],
)
